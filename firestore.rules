rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Setiap user hanya boleh baca/tulis dokumen profilnya sendiri
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Sub-koleksi data (transaksi & aset) — sama aturannya
      match /data/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
